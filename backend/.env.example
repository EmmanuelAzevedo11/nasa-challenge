APP_NAME="AgroSat SP"
APP_ENV=development

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_REQUESTS_PER_MINUTE=8
GEMINI_TIMEOUT_SECONDS=35

NASA_POWER_BASE_URL=https://power.larc.nasa.gov
OPEN_METEO_BASE_URL=https://api.open-meteo.com
MODIS_BASE_URL=https://modis.ornl.gov/rst/api/v1
OPENTOPODATA_BASE_URL=https://api.opentopodata.org
SOILGRIDS_WCS_URL=https://maps.isric.org/mapserv
ANA_STATION_URL=https://www.snirh.gov.br/arcgis/rest/services/SGH/REDE_HIDROMETEOROLOGICA_NACIONAL/MapServer/3/query

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HTTP_TIMEOUT_SECONDS=10
HTTP_RETRIES=1
CACHE_TTL_SECONDS=900
CLIMATE_CACHE_TTL_SECONDS=21600
CACHE_MAX_ENTRIES=512

ZARC_DATA_DIR=app/data/zarc
